# Existing Manus/MySQL path (remains the default during the staged migration)
BACKEND_PROVIDER=mysql
DATABASE_URL=
VITE_APP_ID=
JWT_SECRET=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
OWNER_NAME=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
CORS_ORIGIN=http://localhost:8081
HOST=0.0.0.0
PORT=3000

# Public Expo configuration. The anon key is designed for clients; RLS is mandatory.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server configuration. Never expose the service-role key to Expo or Git.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SITE_SLUG=island-ride

# Explicit non-production demo seeding gate.
SUPABASE_PROJECT_ENV=local
ALLOW_DEMO_SEEDING=false
SEED_ALLOWED_PROJECT_REF=
ISLAND_RIDE_SEED_SUPERADMIN_EMAIL=avery.agency@example.invalid
ISLAND_RIDE_SEED_SUPERADMIN_PASSWORD=
ISLAND_RIDE_SEED_ADMIN_EMAIL=jordan.owner@example.invalid
ISLAND_RIDE_SEED_ADMIN_PASSWORD=
ISLAND_RIDE_SEED_CUSTOMER_EMAIL=casey.customer@example.invalid
ISLAND_RIDE_SEED_CUSTOMER_PASSWORD=

# Transactional email is disabled by default. Preview and production use
# different domain-restricted keys, verified senders, and webhook secrets.
EMAIL_DELIVERY_ENABLED=false
EMAIL_ENVIRONMENT=preview
RESEND_API_KEY_PREVIEW=
RESEND_FROM_PREVIEW=IslandRide Preview <preview@preview.example.invalid>
RESEND_WEBHOOK_SECRET_PREVIEW=
RESEND_API_KEY_PRODUCTION=
RESEND_FROM_PRODUCTION=IslandRide <rides@example.invalid>
RESEND_WEBHOOK_SECRET_PRODUCTION=
